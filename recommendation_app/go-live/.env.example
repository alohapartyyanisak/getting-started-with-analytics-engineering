# Canonical environment template for recommendation_app/go-live
# Populate locally as .env when running go-live workflows or local hosted tests.
# This file intentionally includes only go-live-relevant settings.

# Local debugging / runtime
DEBUG=
PORT=8080

# Phase 2 / Phase 3 dataset runtime
GO_LIVE_DATASET_STORAGE_ROOT=/tmp/go-live/data/storage
GO_LIVE_DATASET_POINTER_FILE=latest.json
GO_LIVE_DATASET_VERSION=
GO_LIVE_DATASET_URI=
GO_LIVE_PRIMARY_ARTIFACT_ROOT_URI=
GO_LIVE_SYNC_FROM_GCS=true

# Cloud storage / deploy contract
GCS_DATASET_URI=
GCP_PROJECT_ID=
GCP_REGION=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=

# GitHub automation
GH_TOKEN=

# Scheduler / retention notifications
PROD_SCHED_NOTIFY_URL=
PROD_SCHED_NOTIFY_BEARER_TOKEN=
PROD_SCHED_NOTIFY_ON=
PROD_RETENTION_NOTIFY_URL=
PROD_RETENTION_NOTIFY_BEARER_TOKEN=
PROD_RETENTION_NOTIFY_ON=

# Resolver credentials
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LangSmith tracing / webhook adapter
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=go-live-ops
LANGSMITH_WORKSPACE_ID=
LANGSMITH_API_URL=https://api.smith.langchain.com
LANGSMITH_ADAPTER_BEARER_TOKEN=
LANGSMITH_ADAPTER_HOST=0.0.0.0
LANGSMITH_ADAPTER_PORT=8080
