# See recommendation_app/go-live/.env.example for the full go-live env contract.
# This file is the minimal runtime subset for app/container usage.

# Container / Cloud Run runtime
PORT=8080

# Phase 2 / Phase 3 dataset runtime
GO_LIVE_DATASET_STORAGE_ROOT=/app/recommendation_app/go-live/data/storage
GO_LIVE_DATASET_POINTER_FILE=latest.json
GO_LIVE_DATASET_VERSION=
GO_LIVE_DATASET_URI=
GO_LIVE_PRIMARY_ARTIFACT_ROOT_URI=
GO_LIVE_SYNC_FROM_GCS=true

# Existing scheduler / storage contract
GCP_PROJECT_ID=
GCS_DATASET_URI=
GCP_REGION=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=

# Optional scheduler notifications
PROD_SCHED_NOTIFY_URL=
PROD_SCHED_NOTIFY_BEARER_TOKEN=
PROD_RETENTION_NOTIFY_URL=
PROD_RETENTION_NOTIFY_BEARER_TOKEN=

# LangSmith webhook adapter
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=go-live-ops
LANGSMITH_WORKSPACE_ID=
LANGSMITH_API_URL=https://api.smith.langchain.com
LANGSMITH_ADAPTER_BEARER_TOKEN=
