# Dataset root and pointer (prod environment)
GO_LIVE_DATASET_STORAGE_ROOT=/path/to/go-live/data/storage
GO_LIVE_DATASET_POINTER_FILE=latest.json

# Scheduler entrypoint controls
PROD_SCHED_MODE=problem_queue_bounded
PROD_SCHED_WORKERS=16
PROD_SCHED_FORCE=false
PROD_SCHED_BEHAVIORAL_STATUS=unknown
PROD_SCHED_MANUAL_STATUS=unknown
PROD_SCHED_AUTO_PROMOTE=false
PROD_SCHED_PUBLISH_TIMEOUT_SECONDS=1800
PROD_SCHED_PROBLEM_MAX_ROWS=1200
PROD_SCHED_PROBLEM_MAX_RESOLVE_KEYS=400
PROD_SCHED_POST_SMOKE=true

# Optional run-result notification hook (POST JSON webhook)
# Send only on selected status groups: ok,error
PROD_SCHED_NOTIFY_URL='https://eoyfa9rvcflfg3d.m.pipedream.net'
PROD_SCHED_NOTIFY_ON=ok,error
PROD_SCHED_NOTIFY_TIMEOUT_SECONDS=10
PROD_SCHED_NOTIFY_BEARER_TOKEN='45182a0b02ac85edb800f3821104295d'

# Retention scheduler controls
PROD_RETENTION_DAYS=60
PROD_DRY_RUN_SNAPSHOT_RETENTION_DAYS=14
PROD_RUN_LOG_RETENTION_DAYS=30
PROD_RETENTION_APPLY=false

# Optional retention notification hook (falls back to scheduler notify URL/token)
PROD_RETENTION_NOTIFY_URL='https://eoyfa9rvcflfg3d.m.pipedream.net'
PROD_RETENTION_NOTIFY_ON=ok,error
PROD_RETENTION_NOTIFY_TIMEOUT_SECONDS=10
PROD_RETENTION_NOTIFY_BEARER_TOKEN='45182a0b02ac85edb800f3821104295d'
